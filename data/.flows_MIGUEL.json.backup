","libs":[],"x":630,"y":2240,"wires":[["e1d7ea16724a5c25"]]},{"id":"final_response","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"FINAL","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: {\n        categoria:msg.resultado.categoria, \n        grupo:msg.resultado.grupo,\n        clase: msg.resultado.clase,\n        familia: msg.resultado.familia\n                }\n\n};\n\nreturn msg;\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1930,"y":2300,"wires":[["http_response_master"]]},{"id":"http_response_master","type":"http response","z":"flow1","g":"eeb98d7c5304d479","name":"HTTP Response","x":2220,"y":2300,"wires":[]},{"id":"4797848788d284c3","type":"subflow:4288a9a7238e6cf3","z":"flow1","g":"eeb98d7c5304d479","name":"","x":420,"y":2240,"wires":[["init_master"],["ff53075153838a52"]]},{"id":"ff53075153838a52","type":"link out","z":"flow1","g":"eeb98d7c5304d479","name":"link out 3","mode":"link","links":["d11d1f93d1d394de"],"x":535,"y":2380,"wires":[]},{"id":"f750659935fbc0d8","type":"subflow:11b322b06c6ffde9","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1200,"y":1860,"wires":[["http_resp"]]},{"id":"ae96bc363bcc1e32","type":"subflow:d850890bbe7ced0f","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1180,"y":1920,"wires":[["http_resp"]]},{"id":"c25112768633d296","type":"subflow:e3761457f220ce0c","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1180,"y":1980,"wires":[["http_resp"]]},{"id":"0ab14b4ea46491c7","type":"subflow:7d59a05f0ec995c8","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1190,"y":2040,"wires":[["http_resp"]]},{"id":"d11d1f93d1d394de","type":"link in","z":"flow1","g":"eeb98d7c5304d479","name":"link in 4","links":["ff53075153838a52"],"x":2105,"y":2380,"wires":[["http_response_master"]]},{"id":"e1d7ea16724a5c25","type":"subflow:11b322b06c6ffde9","z":"flow1","g":"eeb98d7c5304d479","name":"","x":840,"y":2240,"wires":[["64c66c7ca0487e41"]]},{"id":"64c66c7ca0487e41","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"Respuesta Categoria","func":"msg.resultado.categoria = msg.payload;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":2300,"wires":[["1d2c2c7786a0dafe"]]},{"id":"1d2c2c7786a0dafe","type":"subflow:d850890bbe7ced0f","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1140,"y":2240,"wires":[["7393cb4b96253fca"]]},{"id":"7393cb4b96253fca","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"Respuesta Grupo","func":"msg.resultado.grupo = msg.payload;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1150,"y":2300,"wires":[["03c73f7dd928dfb7"]]},{"id":"03c73f7dd928dfb7","type":"subflow:e3761457f220ce0c","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1440,"y":2240,"wires":[["f622e45ec0d6309d"]]},{"id":"f622e45ec0d6309d","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"Respuesta Clase","func":"msg.resultado.clase = msg.payload;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1450,"y":2300,"wires":[["4fda3c412b2e6261"]]},{"id":"4fda3c412b2e6261","type":"subflow:7d59a05f0ec995c8","z":"flow1","g":"eeb98d7c5304d479","name":"","x":1730,"y":2240,"wires":[["29da13c1aaa919e8"]]},{"id":"29da13c1aaa919e8","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"Respuesta Familia","func":"msg.resultado.familia = msg.payload;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1730,"y":2300,"wires":[["final_response"]]},{"id":"fd383d6c52a8c722","type":"catch","z":"flow1","g":"eeb98d7c5304d479","name":"ERROR","scope":"group","uncaught":false,"x":1840,"y":2160,"wires":[["7e46ff994da1b7b2"]]},{"id":"7e46ff994da1b7b2","type":"function","z":"flow1","g":"eeb98d7c5304d479","name":"RESPONSE","func":"msg.statusCode=500;msg.payload={status:'error',message:msg.error.message,timestamp:new Date().toISOString()};return msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2010,"y":2160,"wires":[["http_response_master"]]},{"id":"abe2b5b10a41f824","type":"http in","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"POST Migrar Cobros","url":"/maestros/migrarcobros","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":170,"y":140,"wires":[["09860afdec6d360c"]]},{"id":"8794ce4f55140c4f","type":"function","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"Validar Input","func":"let id = msg.req.body.id_cobro;\n\nif (!id) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Parametro id_cobro es requerido\"\n    };\n    return [null, msg];\n}\n\nmsg.id_cobro = id;\nreturn [msg, null];","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":690,"y":140,"wires":[["1e4c93e9ed4e97e6"],["9034ef5c8cfa0436"]]},{"id":"1e4c93e9ed4e97e6","type":"function","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"SP Cobros","func":"msg.topic = \"CALL sp_cobros_migracion_erp(?)\";\nmsg.payload = [msg.id_cobro];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":900,"y":80,"wires":[["2be2b2619ee91ed5"]]},{"id":"4b81542dd89353a9","type":"function","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"Formatear Respuesta","func":"msg.payload = {\n    status: \"ok\",\n    id_cobro: msg.id_cobro,\n    data: msg.payload\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1380,"y":380,"wires":[[]]},{"id":"9034ef5c8cfa0436","type":"http response","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"HTTP Response","x":1780,"y":140,"wires":[]},{"id":"129e9a37710e2abe","type":"catch","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"Errores","scope":null,"uncaught":false,"x":910,"y":200,"wires":[["d7aeb3ccc44c1657"]]},{"id":"d7aeb3ccc44c1657","type":"function","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"Formato Error","func":"msg.statusCode = 500;\nmsg.payload = {\n    status: \"error\",\n    message: msg.error.message,\n    timestamp: new Date().toISOString()\n};\nreturn msg;","outputs":1,"x":1140,"y":200,"wires":[["9034ef5c8cfa0436"]]},{"id":"2be2b2619ee91ed5","type":"subflow:143d5ed27166ba3c","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"","x":1080,"y":80,"wires":[["b14fad52d0f46002"]]},{"id":"09860afdec6d360c","type":"subflow:4288a9a7238e6cf3","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"","x":440,"y":140,"wires":[["8794ce4f55140c4f"],["587d65be9c88d1c2"]]},{"id":"587d65be9c88d1c2","type":"link out","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"link out 4","mode":"link","links":["1730f6e83101be80"],"x":585,"y":240,"wires":[]},{"id":"1730f6e83101be80","type":"link in","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"link in 5","links":["587d65be9c88d1c2"],"x":1385,"y":240,"wires":[["9034ef5c8cfa0436"]]},{"id":"b14fad52d0f46002","type":"function","z":"eae33eb5f37ab6bc","g":"d5ed10ca66cfa5d1","name":"function 1","func":"let result = msg.payload;\n\n// validar estructura\nif (!result || !result[0] || !result[0][0] || !result[0][0].resultado) {\n    msg.payload = {\n        status: \"error\",\n        message: \"Respuesta inválida del SP\"\n    };\n    return msg;\n}\n\ntry {\n    let jsonString = result[0][0].resultado;\n\n    // 🔥 convertir STRING a JSON real\n    let data = JSON.parse(jsonString);\n\n    msg.payload = {\n        status: \"ok\",\n        id_cobro: data.id_cobro,\n        data: data\n    };\n\n} catch (err) {\n    msg.payload = {\n        status: \"error\",\n        message: \"Error parseando JSON\",\n        detalle: err.message\n    };\n}\n\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1520,"y":80,"wires":[["9034ef5c8cfa0436"]]}]