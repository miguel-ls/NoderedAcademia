nodes":["http_in_cursos","fn_sql_cursos","fn_transform_cursos","fn_response_cursos","bf0c7ab07c2ad5f7","11c18464a2c13b36","3b38cdd578c0ce8f","8cedfe2f2b926f49","68195ff263539964","3718e0d4dfd3a107","e455fd0114cc6f94","7e993e34788baf41","b1715579048129d7","e5b3803b6d5f5c72","12fd2d89b136fbe2","4e18691aa3a85c7a","9951258e36bd20e5","c85462604255e864","3e6c4f4431e87919","77f3fad64f2aba0d","3e43db00f7b659f9","11542547392efddc","dd2292abce87806d","6c8309febf1deb96","18bb4a4012c010d5","53e6e86435d2d186","fc1514f439141385","6801ea96c00586c8","15062529a5a031af","b9aa73ebde4d9dbc","3721dea03f213698","b43d5f8a0f5aec1d","241392c2a1f7ee41","aafd3a41326ff5f4","3311302718add704","25f7d3e6971a72d6","4572e0d5424b12c6","a2356516365a204a","5fb3689e443b5fc6"],"x":34,"y":799,"w":2352,"h":602},{"id":"7a12b23d2851b89f","type":"group","z":"flow1","name":"Carga Inicial","style":{"stroke":"#9363b7","label":true,"color":"#9363b7"},"nodes":["b189ccc3adbe8be1","2ba820a27efcb408"],"x":34,"y":19,"w":512,"h":82},{"id":"mysql_config","type":"MySQLdatabase","name":"ONG_DB","host":"${MYSQL_DB_HOST}","port":"${MYSQL_DB_PORT}","db":"${MYSQL_DB_DATABASE}","tz":"","charset":"UTF8"},{"id":"mssql_config","type":"MSSQL-CN","tdsVersion":"7_4","name":"ACADEMIA_ED","server":"${MSSQL_DB_HOST}","port":"${MSSQL_DB_PORT}","encyption":false,"trustServerCertificate":true,"database":"${MSSQL_DB_DATABASE}","useUTC":true,"connectTimeout":"15000","requestTimeout":"15000","cancelTimeout":"5000","pool":"5","parseJSON":false,"enableArithAbort":true,"readOnlyIntent":false},{"id":"3dabfb7ada7d9ed1","type":"function","z":"4288a9a7238e6cf3","name":"🔐 AUTORIZAR","func":"let token = msg.req.headers['authorization'];\nif (!token || token !== 'Bearer ' + global.get(\"token\")){\n msg.statusCode=401;\n msg.payload={status:'error',message:'No autorizado'};\n return [null,msg];\n}\nreturn [msg,null];","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":240,"y":80,"wires":[[],[]]},{"id":"c9ad99f8f6c48c40","type":"MSSQL","z":"7a24865852a0fd5b","mssqlCN":"mssql_config","name":"MSSSQL","outField":"payload","returnType":"0","throwErrors":"1","query":"","modeOpt":"","modeOptType":"query","queryOpt":"topic","queryOptType":"msg","paramsOpt":"params","paramsOptType":"msg","rows":"msg.payload","rowsType":"msg","parseMustache":false,"params":[],"x":200,"y":80,"wires":[[]]},{"id":"5fbc467dc99e2ebb","type":"mysql","z":"143d5ed27166ba3c","mydb":"mysql_config","name":"Insert MySQL Bulk","x":230,"y":80,"wires":[[]]},{"id":"http_in_sql","type":"http in","z":"flow1","g":"710496859be7c313","name":"GET Consultar Entidades","url":"/maestros/consultarentidades","method":"get","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":170,"y":280,"wires":[["8446697e9d608d83"]]},{"id":"function_sql","type":"function","z":"flow1","g":"710496859be7c313","name":"consultar","func":"// parametros\nlet emp = msg.req.query.Emp_cCodigo || null;\nlet ent = msg.req.query.Ent_cCodEntidad || null;\n\n// query\nmsg.topic = `\nSELECT * \nFROM CNM_ENTIDAD \nWHERE Emp_cCodigo = @Emp_cCodigo \nAND Ten_cTipoEntidad = 'C' \nAND Ent_cCodEntidad = \n    (CASE \n        WHEN ISNULL(@Ent_cCodEntidad, '') = '' THEN Ent_cCodEntidad \n        ELSE @Ent_cCodEntidad \n     END)\n`;\n\n// 👇 FORMATO CORRECTO PARA MSSQL NODE\nmsg.params = [\n    {\n        name: \"Emp_cCodigo\",\n        type: \"VarChar\",\n        value: emp\n    },\n    {\n        name: \"Ent_cCodEntidad\",\n        type: \"VarChar\",\n        value: ent\n    }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":280,"wires":[["1c181471b1e4a7bc"]]},{"id":"3f823a24745d743c","type":"http in","z":"flow1","g":"710496859be7c313","name":"POST Migrar Clientes","url":"/maestros/migrarclientes","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":160,"y":180,"wires":[["9652d4c7603ca3ad"]]},{"id":"40e3c05e8a21b7e6","type":"function","z":"flow1","g":"710496859be7c313","name":"migrar","func":"let emp = msg.payload.Emp_cCodigo;\n\nmsg.topic = `\nSELECT *\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ten_cTipoEntidad = 'C'\nAND ISNULL(Ent_cDeleted,'') <> '*'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: emp }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":200,"wires":[["9c094d5549863d5d"]]},{"id":"c17b6bc640b47ef8","type":"function","z":"flow1","g":"710496859be7c313","name":"Transform + Bulk Insert","func":"let rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin datos\", insertados: 0 };\n    return msg;\n}\n\n// 🔥 MAPEO TIPO DOCUMENTO\nfunction mapTipoDoc(tipo) {\n    switch (tipo) {\n        case \"01\": return 1; // DNI\n        case \"05\": return 2; // Pasaporte\n        case \"03\": return 3; // Carnet extranjería\n        default: return null;\n    }\n}\n\n// 🔥 MAPEO ESTADO\nfunction mapEstado(estado) {\n    return (estado === \"A\") ? \"Activado\" : \"Desactivado\";\n}\n\nlet values = [];\nlet placeholders = [];\nlet total = 0;\n\nrows.forEach(r => {\n\n    if (!r.Ent_nRuc) return;\n\n    let tipoDoc = mapTipoDoc(r.Ent_cTipoDoc);\n    if (!tipoDoc) return;\n\n    let estado = mapEstado(r.Ent_cEstado);\n\n    placeholders.push(\"(?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\");\n\n    values.push(\n        tipoDoc,\n        r.Ent_nRuc,\n        r.Ent_cPersona,\n        r.En_nMail,\n        r.Ent_nTelefono,\n        r.Ent_cCodEntidad,\n        estado, // 🔥 aquí va el mapeo\n        r.Ent_cDireccion,\n        \"\",\n        r.Ent_dFechaCrea,\n        r.Ent_Observacion\n    );\n\n    total++;\n});\n\nif (values.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin registros válidos\", insertados: 0 };\n    return msg;\n}\n\nmsg.topic = `\nINSERT IGNORE INTO clientes\n(id_tipo_documento, numero_documento, nombres, email, telefono, codigo_erp, estado, direccion, codigo_ubigeo, fecha_creacion, observaciones)\nVALUES ${placeholders.join(\",\")}\n`;\n\nmsg.payload = values;\nmsg.total = total;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1590,"y":200,"wires":[["4dd7a327da8df70b"]]},{"id":"4d8296f73816aa57","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = {\n    statuscode:200,\n    status: \"ok\",\n    message: \"Migración completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2010,"y":200,"wires":[["http_response_delete"]]},{"id":"http_in_cursos","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"POST Migrar Cursos","url":"/maestros/migrarcursos","method":"post","x":150,"y":840,"wires":[["11542547392efddc"]]},{"id":"fn_sql_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"migrar","func":"let emp = msg.payload.Emp_cCodigo;\n\nmsg.topic = `\nSELECT *\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: emp }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":860,"wires":[["241392c2a1f7ee41"]]},{"id":"fn_transform_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Transform + Bulk Cursos","func":"let rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin datos\", insertados: 0 };\n    return msg;\n}\n\n// función para escapar strings\nfunction escape(val) {\n    if (val === null || val === undefined) return \"NULL\";\n    return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\nlet values = [];\nlet total = 0;\n\nrows.forEach(r => {\n\n    if (!r.Cab_cCatalogo) return;\n\n    values.push(`(\n        1,\n        ${escape(r.Cab_cDescripLarga)},\n        '',\n        ${escape(r.Cab_cCatalogo)}\n    )`);\n\n    total++;\n});\n\nif (values.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin registros válidos\", insertados: 0 };\n    return msg;\n}\n\nmsg.topic = `\nINSERT IGNORE INTO cursos\n(id_tipo_curso, nombre, descripcion, codigo_erp)\nVALUES ${values.join(\",\")}\n`;\n\nmsg.payload = null; // 🔥 importante\n\nmsg.total = total;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1590,"y":860,"wires":[["5fb3689e443b5fc6"]]},{"id":"fn_response_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración cursos completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2030,"y":860,"wires":[["9951258e36bd20e5"]]},{"id":"759e380d42f42721","type":"http in","z":"flow1","g":"710496859be7c313","name":"POST Crear Cliente","url":"/maestros/crearcliente","method":"post","x":150,"y":380,"wires":[["fefdab3ec1bac1be"]]},{"id":"8e1f3e8aee0a8840","type":"function","z":"flow1","g":"710496859be7c313","name":"insertar","func":"let b = msg.body;\n\n// simple random (puedes cambiar a correlativo real)\nlet codigo = Math.floor(10000 + Math.random() * 90000).toString();\n\nmsg.topic = `\nINSERT INTO CNM_ENTIDAD (\n    Emp_cCodigo,\n    Ent_cCodEntidad,\n    Ten_cTipoEntidad,\n    Ent_cPersona,\n    Ent_cDireccion,\n    Ent_nRuc,\n    Ent_cTipoDoc,\n    En_nMail,\n    Ent_nTelefono,\n    Ent_cEstado,\n    Ent_dFechaCrea\n)\nVALUES (\n    @Emp_cCodigo,\n    @Ent_cCodEntidad,\n    'C',\n    @Ent_cPersona,\n    @Ent_cDireccion,\n    @Ent_nRuc,\n    @Ent_cTipoDoc,\n    @En_nMail,\n    @Ent_nTelefono,\n    @Ent_cEstado,\n    GETDATE()\n)\n`;\n\n// 🔥 MAPEO ESTADO\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: codigo },\n  { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n  { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n  { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n  { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n  { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n  { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n  { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado }\n];\n\nmsg.codigo = codigo;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":380,"wires":[["1c8a682048791a6a"]]},{"id":"19b3c06ba96cd553","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Cliente creado en SQL Server\",\n    codigo_generado: msg.codigo\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":380,"wires":[["http_response_delete"]]},{"id":"http_in_update","type":"http in","z":"flow1","g":"710496859be7c313","name":"PUT Editar Cliente","url":"/maestros/editarcliente","method":"put","x":150,"y":480,"wires":[["cd6b6f6b2e734941"]]},{"id":"fn_update","type":"function","z":"flow1","g":"710496859be7c313","name":"actualizar","func":"let b = msg.payload;\n\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.topic = `\nUPDATE CNM_ENTIDAD\nSET\n    Ent_cPersona = @Ent_cPersona,\n    Ent_cDireccion = @Ent_cDireccion,\n    Ent_nRuc = @Ent_nRuc,\n    Ent_cTipoDoc = @Ent_cTipoDoc,\n    En_nMail = @En_nMail,\n    Ent_nTelefono = @Ent_nTelefono,\n    Ent_cEstado = @Ent_cEstado,\n    Ent_dFechaModifica = GETDATE()\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo },\n  { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n  { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n  { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n  { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n  { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n  { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n  { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":480,"wires":[["fd49c9bf7b46c607"]]},{"id":"fn_resp_update","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = { \n    statuscode: 200,\n    status: \"ok\", \n    message: \"Cliente actualizado\" \n    };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":480,"wires":[["http_response_delete"]]},{"id":"http_in_delete","type":"http in","z":"flow1","g":"710496859be7c313","name":"DELETE Cliente","url":"/maestros/eliminarcliente","method":"delete","x":140,"y":580,"wires":[["79e43b1907658d52"]]},{"id":"fn_delete","type":"function","z":"flow1","g":"710496859be7c313","name":"eliminar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE CNM_ENTIDAD\nSET\n    Ent_cDeleted = '*',\n    Ent_dFechaModifica = GETDATE()\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":580,"wires":[["bfba9955becb5a71"]]},{"id":"fn_resp_delete","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = { statuscode: 200, status: \"ok\", message: \"Cliente eliminado (soft delete)\" };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":580,"wires":[["http_response_delete"]]},{"id":"http_response_delete","type":"http response","z":"flow1","g":"710496859be7c313","name":"HTTP Response","x":2280,"y":440,"wires":[]},{"id":"http_in_ultimo","type":"http in","z":"flow1","g":"710496859be7c313","name":"GET Ultimo Codigo","url":"/maestros/ultimocodigo","method":"get","x":150,"y":680,"wires":[["c26d42f6be1e8087"]]},{"id":"fn_query_ultimo","type":"function","z":"flow1","g":"710496859be7c313","name":"codigo","func":"// puedes hacerlo dinámico si quieres\nlet emp = msg.req.query.Emp_cCodigo || '087';\n\nmsg.topic = `\nSELECT ISNULL(MAX(Ent_cCodEntidad), '00000') AS ultimo\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ten_cTipoEntidad = 'C'\nAND LEFT(Ent_cCodEntidad,1) <> 'A'\n`;\n\nmsg.params = [\n  {\n    name: \"Emp_cCodigo\",\n    type: \"VarChar(3)\",\n    value: emp\n  }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":680,"wires":[["dd51b8460f247e67"]]},{"id":"fn_build_response","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"let data = msg.payload;\n\nlet ultimo = data && data[0] ? data[0].ultimo : '00000';\n\n// convertir a número y sumar\nlet siguiente = (parseInt(ultimo) + 1).toString().padStart(5, '0');\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  ultimo: ultimo,\n  siguiente: siguiente\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":680,"wires":[["http_response_delete"]]},{"id":"bf0c7ab07c2ad5f7","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"POST Crear Curso","url":"/maestros/crearcursos","method":"post","x":150,"y":1040,"wires":[["dd2292abce87806d"]]},{"id":"11c18464a2c13b36","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"insertar","func":"let b = msg.payload;\n\nmsg.topic = `\nINSERT INTO LGM_CATALOGO_BS (\n Emp_cCodigo,\n Cab_cCatalogo,\n Cab_cDescripLarga,\n Cab_cEstado,\n Cab_dFechaCrea\n)\nVALUES (\n @Emp_cCodigo,\n @Cab_cCatalogo,\n @Cab_cDescripLarga,\n 'A',\n GETDATE()\n)\n`;\n\nmsg.params = [\n { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n { name: \"Cab_cCatalogo\", type: \"VarChar(6)\", value: b.codigo },\n { name: \"Cab_cDescripLarga\", type: \"VarChar(600)\", value: b.nombre }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1060,"wires":[["3311302718add704"]]},{"id":"3b38cdd578c0ce8f","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode: 200,\n status:\"ok\",\n message:\"Curso creado correctamente\"\n };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":1060,"wires":[["9951258e36bd20e5"]]},{"id":"8cedfe2f2b926f49","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"PUT Editar Curso","url":"/maestros/editarcursos","method":"put","x":140,"y":1140,"wires":[["6c8309febf1deb96"]]},{"id":"68195ff263539964","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"actualizar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE LGM_CATALOGO_BS\nSET Cab_cDescripLarga=@nombre,\n Cab_dFechaModifica=GETDATE()\nWHERE Emp_cCodigo=@Emp_cCodigo\nAND Cab_cCatalogo=@codigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:b.Emp_cCodigo },\n { name:\"codigo\", type:\"VarChar(6)\", value:b.codigo },\n { name:\"nombre\", type:\"VarChar(600)\", value:b.nombre }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1160,"wires":[["25f7d3e6971a72d6"]]},{"id":"3718e0d4dfd3a107","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode:200,   \n status:\"ok\",\n message:\"Curso actualizado correctamente\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":1160,"wires":[["9951258e36bd20e5"]]},{"id":"e455fd0114cc6f94","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"DELETE Curso","url":"/maestros/eliminarcursos","method":"delete","x":140,"y":1240,"wires":[["18bb4a4012c010d5"]]},{"id":"7e993e34788baf41","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"eliminar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE LGM_CATALOGO_BS\nSET Cab_cDeleted='*', Cab_dFechaModifica=GETDATE()\nWHERE Emp_cCodigo=@Emp_cCodigo\nAND Cab_cCatalogo=@codigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:b.Emp_cCodigo },\n { name:\"codigo\", type:\"VarChar(6)\", value:b.codigo }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1260,"wires":[["4572e0d5424b12c6"]]},{"id":"b1715579048129d7","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode: 200,    \n status:\"ok\",\n message:\"Curso eliminado correctamente\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":1260,"wires":[["9951258e36bd20e5"]]},{"id":"e5b3803b6d5f5c72","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"GET Ultimo Codigo","url":"/maestros/ultimocodigocurso","method":"get","x":150,"y":1340,"wires":[["53e6e86435d2d186"]]},{"id":"12fd2d89b136fbe2","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"codigo","func":"let emp = msg.req.query.Emp_cCodigo || '01';\n\nmsg.topic = `\nSELECT ISNULL(MAX(Cab_cCatalogo),'000000') AS ultimo\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo=@Emp_cCodigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:emp }\n];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":1360,"wires":[["a2356516365a204a"]]},{"id":"4e18691aa3a85c7a","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"let ultimo = msg.payload[0]?.ultimo || '000000';\nlet siguiente = (parseInt(ultimo)+1).toString().padStart(6,'0');\n\nmsg.payload = {\n statuscode: 200,\n status:\"ok\",\n ultimo: ultimo,\n siguiente: siguiente  \n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":1360,"wires":[["9951258e36bd20e5"]]},{"id":"9951258e36bd20e5","type":"http response","z":"flow1","g":"4d6e82be6b5f92e4","name":"HTTP Response","x":2280,"y":1180,"wires":[]},{"id":"18f4a24c6071fed8","type":"catch","z":"flow1","g":"710496859be7c313","name":"ERROR","x":1840,"y":680,"wires":[["d3e5365830b78553"]]},{"id":"d3e5365830b78553","type":"function","z":"flow1","g":"710496859be7c313","name":"RESPONSE","func":"msg.statusCode=500;msg.payload={status:'error',message:msg.error.message,timestamp:new Date().toISOString()};return msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2010,"y":680,"wires":[["http_response_delete"]]},{"id":"c85462604255e864","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"RESPONSE","func":"msg.statusCode=500;msg.payload={status:'error',message:msg.error.message,timestamp:new Date().toISOString()};return msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2030,"y":1360,"wires":[["9951258e36bd20e5"]]},{"id":"3e6c4f4431e87919","type":"catch","z":"flow1","g":"4d6e82be6b5f92e4","name":"ERROR","x":1860,"y":1360,"wires":[["c85462604255e864"]]},{"id":"9a8fae89658879da","type":"link in","z":"flow1","g":"710496859be7c313","name":"link in 1","links":["06b326be8765627b"],"x":2005,"y":300,"wires":[["http_response_delete"]]},{"id":"06b326be8765627b","type":"link out","z":"flow1","g":"710496859be7c313","name":"link out 1","mode":