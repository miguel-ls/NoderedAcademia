a8840"],["fn_update"],["fn_delete"],["fn_query_ultimo"],["b228370fb6c3de2e"]]},{"id":"9652d4c7603ca3ad","type":"function","z":"flow1","g":"710496859be7c313","name":"migrar","func":"msg.caso =\"migrar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":180,"wires":[["4b56bd36549740bd"]]},{"id":"8446697e9d608d83","type":"function","z":"flow1","g":"710496859be7c313","name":"consultar","func":"msg.caso =\"consultar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":280,"wires":[["4b56bd36549740bd"]]},{"id":"fefdab3ec1bac1be","type":"function","z":"flow1","g":"710496859be7c313","name":"insertar","func":"let body = msg.payload;\n\nif (!body.Emp_cCodigo || !body.numero_documento || !body.nombres) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Datos incompletos\" };\n    return msg;\n}\n\nmsg.caso =\"insertar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":380,"wires":[["4b56bd36549740bd"]]},{"id":"cd6b6f6b2e734941","type":"function","z":"flow1","g":"710496859be7c313","name":"actualizar","func":"msg.caso =\"actualizar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":480,"wires":[["4b56bd36549740bd"]]},{"id":"79e43b1907658d52","type":"function","z":"flow1","g":"710496859be7c313","name":"eliminar","func":"msg.caso =\"eliminar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":580,"wires":[["4b56bd36549740bd"]]},{"id":"c26d42f6be1e8087","type":"function","z":"flow1","g":"710496859be7c313","name":"codigo","func":"msg.caso =\"codigo\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":680,"wires":[["4b56bd36549740bd"]]},{"id":"11542547392efddc","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"migrar","func":"msg.caso =\"migrar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":960,"wires":[["fc1514f439141385"]]},{"id":"dd2292abce87806d","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"insertar","func":"msg.caso =\"insertar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1160,"wires":[["fc1514f439141385"]]},{"id":"6c8309febf1deb96","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"actualizar","func":"msg.caso =\"actualizar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1260,"wires":[["fc1514f439141385"]]},{"id":"18bb4a4012c010d5","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"eliminar","func":"msg.caso =\"eliminar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1360,"wires":[["fc1514f439141385"]]},{"id":"53e6e86435d2d186","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"codigo","func":"msg.caso =\"codigo\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":1460,"wires":[["fc1514f439141385"]]},{"id":"fc1514f439141385","type":"subflow:4288a9a7238e6cf3","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":680,"y":1280,"wires":[["6801ea96c00586c8"],["3e43db00f7b659f9"]]},{"id":"6801ea96c00586c8","type":"switch","z":"flow1","g":"4d6e82be6b5f92e4","name":"ROUTER","property":"caso","propertyType":"msg","rules":[{"t":"eq","v":"migrar","vt":"str"},{"t":"eq","v":"consultar","vt":"str"},{"t":"eq","v":"insertar","vt":"str"},{"t":"eq","v":"actualizar","vt":"str"},{"t":"eq","v":"eliminar","vt":"str"},{"t":"eq","v":"codigo","vt":"str"},{"t":"eq","v":"upsert","vt":"str"}],"repair":false,"outputs":7,"x":900,"y":1280,"wires":[["fn_sql_cursos"],["3721dea03f213698"],["11c18464a2c13b36"],["68195ff263539964"],["7e993e34788baf41"],["12fd2d89b136fbe2"],["7349cf354c601a6f"]]},{"id":"15062529a5a031af","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"GET Consultar Cursos","url":"/maestros/consultarcursos","method":"get","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":160,"y":1060,"wires":[["b9aa73ebde4d9dbc"]]},{"id":"b9aa73ebde4d9dbc","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"consultar","func":"msg.caso =\"consultar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1060,"wires":[["fc1514f439141385"]]},{"id":"3721dea03f213698","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"consultar","func":"// parametros\nlet emp = msg.req.query.Emp_cCodigo || null;\nlet cat = msg.req.query.Cab_cCatalogo || null;\n\n// query\nmsg.topic = `\nSELECT * \nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo \nAND Cab_cCatalogo = \n    (CASE \n        WHEN ISNULL(@Cab_cCatalogo, '') = '' THEN Cab_cCatalogo\n        ELSE @Cab_cCatalogo\n     END)\n`;\n\n// 👇 FORMATO CORRECTO PARA MSSQL NODE\nmsg.params = [\n    {\n        name: \"Emp_cCodigo\",\n        type: \"VarChar\",\n        value: emp\n    },\n    {\n        name: \"Cab_cCatalogo\",\n        type: \"VarChar\",\n        value: cat\n    }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1080,"wires":[["aafd3a41326ff5f4"]]},{"id":"9c094d5549863d5d","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":200,"wires":[["c17b6bc640b47ef8"]]},{"id":"1c181471b1e4a7bc","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":280,"wires":[["464697d85bee965c"]]},{"id":"1c8a682048791a6a","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":380,"wires":[["19b3c06ba96cd553"]]},{"id":"fd49c9bf7b46c607","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":480,"wires":[["fn_resp_update"]]},{"id":"bfba9955becb5a71","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":580,"wires":[["fn_resp_delete"]]},{"id":"dd51b8460f247e67","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1450,"y":680,"wires":[["fn_build_response"]]},{"id":"464697d85bee965c","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"let data = msg.payload;\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  data: data\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":280,"wires":[["http_response_delete"]]},{"id":"b43d5f8a0f5aec1d","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"let data = msg.payload;\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  data: data\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":1080,"wires":[["9951258e36bd20e5"]]},{"id":"241392c2a1f7ee41","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":980,"wires":[["fn_transform_cursos"]]},{"id":"aafd3a41326ff5f4","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":1080,"wires":[["b43d5f8a0f5aec1d"]]},{"id":"3311302718add704","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":1180,"wires":[["3b38cdd578c0ce8f"]]},{"id":"25f7d3e6971a72d6","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":1280,"wires":[["3718e0d4dfd3a107"]]},{"id":"4572e0d5424b12c6","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":1380,"wires":[["b1715579048129d7"]]},{"id":"a2356516365a204a","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1450,"y":1480,"wires":[["4e18691aa3a85c7a"]]},{"id":"4dd7a327da8df70b","type":"subflow:143d5ed27166ba3c","z":"flow1","g":"710496859be7c313","name":"","x":2030,"y":200,"wires":[["4d8296f73816aa57"]]},{"id":"5fb3689e443b5fc6","type":"subflow:143d5ed27166ba3c","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":2030,"y":980,"wires":[["fn_response_cursos"]]},{"id":"b189ccc3adbe8be1","type":"inject","z":"flow1","g":"7a12b23d2851b89f","name":"PRODUCCION","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":160,"y":60,"wires":[["2ba820a27efcb408"]]},{"id":"2ba820a27efcb408","type":"change","z":"flow1","g":"7a12b23d2851b89f","name":"GLOBALS PROD","rules":[{"t":"set","p":"token","pt":"global","to":"TOKEN_NODERED","tot":"env"}],"action":"","property":"","from":"","to":"","reg":false,"x":430,"y":60,"wires":[[]]},{"id":"505709848537fa18","type":"http response","z":"flow1","g":"710496859be7c313","name":"HTTP Response","x":2460,"y":200,"wires":[]},{"id":"dacb96d7f45f5fc0","type":"http response","z":"flow1","g":"4d6e82be6b5f92e4","name":"HTTP Response","x":2500,"y":980,"wires":[]},{"id":"http_in","type":"http in","z":"flow1","g":"710496859be7c313","name":"POST Upsert Cliente","url":"/maestros/upsertcliente","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":780,"wires":[["d1c6f846badf8bd2"]]},{"id":"d1c6f846badf8bd2","type":"function","z":"flow1","g":"710496859be7c313","name":"upsert","func":"let b = msg.payload;\n\nif (!b.Emp_cCodigo ) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Datos incompletos\" };\n    return msg;\n}\n\n\n\nmsg.caso =\"upsert\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":780,"wires":[["4b56bd36549740bd"]]},{"id":"b228370fb6c3de2e","type":"function","z":"flow1","g":"710496859be7c313","name":"Buscar Cliente","func":"let b = msg.payload;\n\nmsg.body = b;\n\nmsg.topic = `\nSELECT TOP 1 Ent_cCodEntidad\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo_erp || '' }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1160,"y":800,"wires":[["c2c54ab55297c41d"]]},{"id":"e3a0b7b93ab4ddfa","type":"function","z":"flow1","g":"710496859be7c313","name":"Decidir Insert / Update","func":"let existe = msg.payload && msg.payload.length > 0;\n\nif (existe) {\n    return [null, msg]; // UPDATE\n} else {\n    return [msg, null]; // INSERT\n}","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":800,"wires":[["e850427e9a16744e"],["faa2ec3b1ab8f214"]]},{"id":"e850427e9a16744e","type":"function","z":"flow1","g":"710496859be7c313","name":"Generar Código","func":"let b = msg.body;\n\nmsg.topic = `\nSELECT RIGHT('00000' + CAST(ISNULL(MAX(CAST(Ent_cCodEntidad AS INT)),0) + 1 AS VARCHAR),5) AS codigo\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND LEFT(Ent_cCodEntidad,1) <> 'A'\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1780,"y":760,"wires":[["ad032acbb35cabaa"]]},{"id":"ad7e533337aa81d2","type":"function","z":"flow1","g":"710496859be7c313","name":"INSERT Cliente","func":"let b = msg.body;\nlet codigo = msg.payload[0].codigo;\n\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.topic = `\nINSERT INTO CNM_ENTIDAD (\n    Emp_cCodigo,\n    Ent_cCodEntidad,\n    Ten_cTipoEntidad,\n    Ent_cPersona,\n    Ent_cDireccion,\n    Ent_nRuc,\n    Ent_cTipoDoc,\n    En_nMail,\n    Ent_nTelefono,\n    Ent_cEstado,\n    Ent_cUserCrea,\n    Ent_dFechaCrea,\n    Ent_cUserModifica,\n    Ent_dFechaModifica\n)\nVALUES (\n    @Emp_cCodigo,\n    @Ent_cCodEntidad,\n    'C',\n    @Ent_cPersona,\n    @Ent_cDireccion,\n    @Ent_nRuc,\n    @Ent_cTipoDoc,\n    @En_nMail,\n    @Ent_nTelefono,\n    @Ent_cEstado,\n    @Ent_cUserCrea,\n    GETDATE(),\n    @Ent_cUserModifica,\n    GETDATE()\n)\n`;\n\nmsg.params = [\n    { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n    { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: codigo },\n\n    { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n    { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n    { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n    { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n    { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n    { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n    { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado },\n\n    // 🔥 AUDITORÍA\n    { name: \"Ent_cUserCrea\", type: \"VarChar(50)\", value: b.usuario_creacion || \"API\" },\n    { name: \"Ent_cUserModifica\", type: \"VarChar(50)\", value: b.usuario_modificacion || b.usuario_creacion || \"API\" }\n];\n\nmsg.resultado = {\n    accion: \"insert\",\n    codigo: codigo\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2180,"y":760,"wires":[["1cdf1ccba93f6216"]]},{"id":"faa2ec3b1ab8f214","type":"function","z":"flow1","g":"710496859be7c313","name":"UPDATE Cliente","func":"let b = msg.body;\n\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.topic = `\nUPDATE CNM_ENTIDAD\nSET\n    Ent_cPersona = @Ent_cPersona,\n    Ent_cDireccion = @Ent_cDireccion,\n    Ent_nRuc = @Ent_nRuc,\n    Ent_cTipoDoc = @Ent_cTipoDoc,\n    En_nMail = @En_nMail,\n    Ent_nTelefono = @Ent_nTelefono,\n    Ent_cEstado = @Ent_cEstado,\n\n    -- 🔥 NUEVOS CAMPOS\n    Ent_cUserModifica = @Ent_cUserModifica,\n    Ent_dFechaModifica = GETDATE()\n\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo_erp },\n\n  { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n  { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n  { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n  { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n  { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n  { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n  { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado },\n\n  // 🔥 NUEVO\n  { name: \"Ent_cUserModifica\", type: \"VarChar(50)\", value: b.usuario_modificacion || \"API\" }\n];\n\nmsg.resultado = {\n  accion: \"update\",\n  codigo: b.codigo_erp\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1780,"y":840,"wires":[["1cdf1ccba93f6216"]]},{"id":"264d523c6a53bbfb","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = {\n    status: \"ok\",\n    accion: msg.resultado.accion,\n    codigo: msg.resultado.codigo,\n    message: msg.resultado.accion === \"insert\" ? \"Cliente creado\" : \"Cliente actualizado\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2470,"y":840,"wires":[["http_response_delete"]]},{"id":"c2c54ab55297c41d","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1350,"y":800,"wires":[["e3a0b7b93ab4ddfa"]]},{"id":"ad032acbb35cabaa","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1990,"y":760,"wires":[["ad7e533337aa81d2"]]},{"id":"1cdf1ccba93f6216","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":2290,"y":840,"wires":[["264d523c6a53bbfb"]]},{"id":"7349cf354c601a6f","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Buscar Curso","func":"let b = msg.payload;\nmsg.body = b;\n\nmsg.topic = `\nSELECT TOP 1 Cab_cCatalogo\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Cab_cCatalogo = @Cab_cCatalogo\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Cab_cCatalogo\", type: \"VarChar(6)\", value: b.codigo_erp || '' }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1160,"y":1600,"wires":[["ef8505c9868ee58a"]]},{"id":"46694cafdbd6e425","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Decidir Insert/Update","func":"let existe = msg.payload && msg.payload.length > 0;\n\nif (existe) {\n    return [null, msg]; // UPDATE\n} else {\n    return [msg, null]; // INSERT\n}","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1570,"y":1600,"wires":[["f261aff959eed7bd"],["e3d545f80c9497b1"]]},{"id":"f261aff959eed7bd","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Generar Código Curso","func":"let b = msg.body;\n\nmsg.topic = `\nSELECT RIGHT('000000' + CAST(ISNULL(MAX(CAST(Cab_cCatalogo AS INT)),0) + 1 AS VARCHAR),6) AS codigo\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1800,"y":1560,"wires":[["cbe1e40ed259cfba"]]},{"id":"8eb908a276f9135b","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"INSERT Curso","func":"let b = msg.body;\nlet codigo = msg.payload[0].codigo;\n\nmsg.topic = `\nINSERT INTO LGM_CATALOGO_BS (\n    Emp_cCodigo,\n    Cab_cCatalogo,\n    Cab_cDescripLarga,\n    Cab_cDescripCorta,\n    Aca_cCategoria,\n    Gru_cGrupo,\n    Cla_cClase,\n    Fam_cFamilia,\n    Cab_cEstado,\n    Cab_cUserCrea,\n    Cab_dFechaCrea\n)\nVALUES (\n    @Emp_cCodigo,\n    @Cab_cCatalogo,\n    @Cab_cDescripLarga,\n    @Cab_cDescripCorta,\n    @Aca_cCategoria,\n    @Gru_cGrupo,\n    @Cla_cClase,\n    @Fam_cFamilia,\n    'A',\n    @Cab_cUserCrea,\n    GETDATE()\n)\n`;\n\nmsg.params = [\n    { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n    { name: \"Cab_cCatalogo\", type: \"VarChar(6)\", value: codigo },\n\n    { name: \"Cab_cDescripLarga\", type: \"VarChar(600)\", value: b.nombre },\n    { name: \"Cab_cDescripCorta\", type: \"VarChar(600)\", value: b.nombre },\n\n    // 🔥 NUEVOS CAMPOS\n    { name: \"Aca_cCategoria\", type: \"VarChar(2)\", value: b.categoria_erp || null },\n    { name: \"Gru_cGrupo\", type: \"VarChar(5)\", value: b.grupo_erp || null },\n    { name: \"Cla_cClase\", type: \"VarChar(4)\", value: b.clase_erp || null },\n    { name: \"Fam_cFamilia\", type: \"VarChar(7)\", value: b.familia_erp || null },\n\n    { name: \"Cab_cUserCrea\", type: \"VarChar(50)\", value: b.usuario_creacion || \"API\" }\n];\n\nmsg.resultado = {\n    accion: \"insert\",\n    codigo: codigo\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2200,"y":1560,"wires":[["151c56938422e0e9"]]},{"id":"e3d545f80c9497b1","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"UPDATE Curso","func":"let b = msg.body;\n\nmsg.topic = `\nUPDATE LGM_CATALOGO_BS\nSET\n    Cab_cDescripLarga = @Cab_cDescripLarga,\n    Cab_cDescripCorta = @Cab_cDescripCorta,\n    Aca_cCategoria    = @Aca_cCategoria,\n    Gru_cGrupo        = @Gru_cGrupo,\n    Cla_cClase        = @Cla_cClase,\n    Fam_cFamilia      = @Fam_cFamilia,\n    Cab_cUserModifica = @Cab_cUserModifica,\n    Cab_dFechaModifica = GETDATE()\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Cab_cCatalogo = @Cab_cCatalogo\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Cab_cCatalogo\", type: \"VarChar(6)\", value: b.codigo_erp },\n\n  { name: \"Cab_cDescripLarga\", type: \"VarChar(600)\", value: b.nombre },\n  { name: \"Cab_cDescripCorta\", type: \"VarChar(600)\", value: b.nombre },\n\n  // 🔥 nuevos campos\n  { name: \"Aca_cCategoria\", type: \"VarChar(2)\", value: b.categoria_erp },\n  { name: \"Gru_cGrupo\", type: \"VarChar(5)\", value: b.grupo_erp },\n  { name: \"Cla_cClase\", type: \"VarChar(4)\", value: b.clase_erp },\n  { name: \"Fam_cFamilia\", type: \"VarChar(7)\", value: b.familia_erp },\n\n  { name: \"Cab_cUserModifica\", type: \"VarChar(50)\", value: b.usuario_modificacion || \"API\" }\n];\n\nmsg.resultado = {\n  accion: \"update\",\n  codigo: b.codigo_erp\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1780,"y":1640,"wires":[["151c56938422e0e9"]]},{"id":"72f4b25b5684367d","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n    status: \"ok\",\n    accion: msg.resultado.accion,\n    codigo: msg.resultado.codigo,\n    message: msg.resultado.accion === \"insert\" ? \"Curso creado\" : \"Curso actualizado\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2480,"y":1640,"wires":[["9951258e36bd20e5"]]},{"id":"ef8505c9868ee58a","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1350,"y":1600,"wires":[["46694cafdbd6e425"]]},{"id":"cbe1e40ed259cfba","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":2000,"y":1560,"wires":[["8eb908a276f9135b"]]},{"id":"151c56938422e0e9","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":2300,"y":1640,"wires":[["72f4b25b5684367d"]]},{"id":"180e1ec8ea50e547","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"POST Upsert Curso","url":"/maestros/upsertcurso","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":1580,"wires":[["cf729d6eb05ca20f"]]},{"id":"cf729d6eb05ca20f","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"upsert","func":"let b = msg.payload;\n\nif (!b.Emp_cCodigo ) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Datos incompletos\" };\n    return msg;\n}\n\n\n\nmsg.caso =\"upsert\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":1580,"wires":[["fc1514f439141385"]]},{"id":"http_cat","type":"http in","z":"flow1","g":"eeb98d7c5304d479","name":"POST Migrar Categoria","url":"/maestros/migrarcategoria","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":160,"y":1760,"wires":[["870943df571cd213"]]},{"id":"http_grp","type":"http in","z":"flow1","g":"eeb98d7c5304d479","name":"POST Migrar Grupo","url":"/maestros/migrargrupo","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":1880,"wires":[["566a34ebbf4f51f2"]]},{"id":"http_cls","type":"http in","z":"flow1","g":"eeb98d7c5304d479","name":"POST Migrar Clase","url":"/maestros/migrarclase","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":2000,"wires":[["cf8a9084fd68ef56"]]},{"id":"http_fam","type":"http in","z":"flow1","g":"eeb98d7c5304d479","name":"POST Migrar Familia","url":"/maestros/migrarfamilia","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":2120,"wires":[["7847e5f7a72d3f5c"]]},{"id":"http_resp","type":"http response","z":"flow1","g":"eeb98d7c5304d479","name":"HTTP Response","statusCode":"","headers":{},"x":1580,"y":1960,"wires":[]},{"id":"03e7c55e19e32ce8","type":"switch","z":"flow1","g":"eeb98d7c5304d479","name":"ROUTER","property":"caso","propertyType":"msg","rules":[{"t":"eq","v":"categoria","vt":"str"},{"t":"eq","v":"grupo","vt":"str"},{"t":"eq","v":"clase","vt":"str"},{"t":"eq","v":"familia","vt":"str"}],"repair":false,"outputs":4,"x":920,"y":1960,"wires":[["f750659935fbc0d8"],["ae96bc363bcc1e32"],["c25112768633d296"],["0ab14b4ea46491c7"]]},{"id":"3a438f3795786c08","type":"subflow:4288a9a7238e6cf3","z":"flow1","g":"eeb98d7c5304d479","name":"","x":700,"y":1960,"wires":[["03e7c55e1