"encyption":false,"trustServerCertificate":true,"database":"${MSSQL_DB_DATABASE}","useUTC":true,"connectTimeout":"15000","requestTimeout":"15000","cancelTimeout":"5000","pool":"5","parseJSON":false,"enableArithAbort":true,"readOnlyIntent":false},{"id":"3dabfb7ada7d9ed1","type":"function","z":"4288a9a7238e6cf3","name":"🔐 AUTORIZAR","func":"let token = msg.req.headers['authorization'];\nif (!token || token !== 'Bearer ' + global.get(\"token\")){\n msg.statusCode=401;\n msg.payload={status:'error',message:'No autorizado'};\n return [null,msg];\n}\nreturn [msg,null];","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":240,"y":80,"wires":[[],[]]},{"id":"c9ad99f8f6c48c40","type":"MSSQL","z":"7a24865852a0fd5b","mssqlCN":"mssql_config","name":"MSSSQL","outField":"payload","returnType":"0","throwErrors":"1","query":"","modeOpt":"","modeOptType":"query","queryOpt":"topic","queryOptType":"msg","paramsOpt":"params","paramsOptType":"msg","rows":"msg.payload","rowsType":"msg","parseMustache":false,"params":[],"x":200,"y":80,"wires":[[]]},{"id":"5fbc467dc99e2ebb","type":"mysql","z":"143d5ed27166ba3c","mydb":"mysql_config","name":"Insert MySQL Bulk","x":230,"y":80,"wires":[[]]},{"id":"fn_cat_query","type":"function","z":"11b322b06c6ffde9","name":"consulta migracion categoria","func":"let emp = msg.req.body.Emp_cCodigo || '087';\n\nmsg.topic = `\nSELECT * FROM LGT_CATEGORIA\nWHERE Emp_cCodigo = @Emp_cCodigo\n`;\n\nmsg.params = [{ name:'Emp_cCodigo', type:'VarChar(3)', value:emp }];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":260,"y":80,"wires":[["e175aa795c9fdf8c"]]},{"id":"fn_cat_transform","type":"function","z":"11b322b06c6ffde9","name":"Transform Categoria + Bulk","func":"let rows = msg.payload;\nlet values = [];\n\nfunction esc(val) {\n    if (val === null || val === undefined) return \"NULL\";\n    return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction formatDate(date) {\n    if (!date) return null;\n\n    let d = new Date(date);\n    if (isNaN(d)) return null;\n\n    let yyyy = d.getFullYear();\n    let mm = String(d.getMonth() + 1).padStart(2, '0');\n    let dd = String(d.getDate()).padStart(2, '0');\n    let hh = String(d.getHours()).padStart(2, '0');\n    let mi = String(d.getMinutes()).padStart(2, '0');\n    let ss = String(d.getSeconds()).padStart(2, '0');\n\n    return `${yyyy}-${mm}-${dd} ${hh}:${mi}:${ss}`;\n}\n\nrows.forEach(r => {\n\n    values.push(`(\n        ${esc(r.Aca_cCategoria)},\n        ${esc(r.Aca_cDescripLarga)},\n        ${esc(r.Aca_cDescripCorta)},\n        ${esc(r.Aca_cEstado)},\n        ${esc(r.Aca_cDeleted)},\n        ${esc(r.Aca_cUserCrea)},\n        ${esc(formatDate(r.Aca_dFechaCrea))},\n        ${esc(r.Aca_cUserModifica)},\n        ${esc(formatDate(r.Aca_dFechaModifica))},\n        ${esc(r.Aca_cEquipoUser)}\n    )`);\n});\n\nmsg.topic = `\nINSERT INTO categoria\n( Aca_cCategoria,\n  Aca_cDescripLarga,\n  Aca_cDescripCorta,\n  Aca_cEstado,\n  Aca_cDeleted,\n  Aca_cUserCrea,\n  Aca_dFechaCrea,\n  Aca_cUserModifica,\n  Aca_dFechaModifica,\n  Aca_cEquipoUser\n)\nVALUES ${values.join(',')}\nON DUPLICATE KEY UPDATE\nAca_cDescripLarga = VALUES(Aca_cDescripLarga),\nAca_cDescripCorta = VALUES(Aca_cDescripCorta),\nAca_cEstado = VALUES(Aca_cEstado),\nAca_cDeleted = VALUES(Aca_cDeleted),\nAca_cUserModifica = VALUES(Aca_cUserModifica),\nAca_dFechaModifica = VALUES(Aca_dFechaModifica)\n`;\n\nmsg.payload = null;\nmsg.total = values.length;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":80,"wires":[["212844e1e25544cc"]]},{"id":"resp_cat","type":"function","z":"11b322b06c6ffde9","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración categoria completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1370,"y":80,"wires":[[]]},{"id":"e175aa795c9fdf8c","type":"subflow:7a24865852a0fd5b","z":"11b322b06c6ffde9","name":"","x":530,"y":80,"wires":[["fn_cat_transform"]]},{"id":"212844e1e25544cc","type":"subflow:143d5ed27166ba3c","z":"11b322b06c6ffde9","name":"","x":1130,"y":80,"wires":[["resp_cat"]]},{"id":"fn_grp_query","type":"function","z":"d850890bbe7ced0f","name":"consulta migracion grupo","func":"let emp = msg.req.body.Emp_cCodigo || '087';\n\nmsg.topic = `SELECT * FROM LGT_GRUPO_BS WHERE Emp_cCodigo=@Emp_cCodigo`;\nmsg.params = [{ name:'Emp_cCodigo', type:'VarChar(3)', value:emp }];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":250,"y":80,"wires":[["e1bfcd2679879416"]]},{"id":"e1bfcd2679879416","type":"subflow:7a24865852a0fd5b","z":"d850890bbe7ced0f","name":"","x":530,"y":80,"wires":[["fn_grp_transform"]]},{"id":"fn_grp_transform","type":"function","z":"d850890bbe7ced0f","name":"Transform Grupo + Bulk","func":"let rows = msg.payload;\nlet values = [];\n\nfunction esc(val) {\n    if (val === null || val === undefined) return \"NULL\";\n    return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction formatDate(date) {\n    if (!date) return null;\n\n    let d = new Date(date);\n    if (isNaN(d)) return null;\n\n    let yyyy = d.getFullYear();\n    let mm = String(d.getMonth() + 1).padStart(2, '0');\n    let dd = String(d.getDate()).padStart(2, '0');\n    let hh = String(d.getHours()).padStart(2, '0');\n    let mi = String(d.getMinutes()).padStart(2, '0');\n    let ss = String(d.getSeconds()).padStart(2, '0');\n\n    return `${yyyy}-${mm}-${dd} ${hh}:${mi}:${ss}`;\n}\n\nrows.forEach(r => {\n\n    if (!r.Aca_cCategoria || !r.Gru_cGrupo) return;\n\n    values.push(`(\n        ${esc(r.Aca_cCategoria)},\n        ${esc(r.Gru_cGrupo)},\n        ${esc(r.Gru_cDescripLarga)},\n        ${esc(r.Gru_cDescripCorta)},\n        ${esc(r.Gru_cEstado)},\n        ${esc(r.Gru_cDeleted)},\n        ${esc(r.Gru_cUserCrea)},\n        ${esc(formatDate(r.Gru_dFechaCrea))},\n        ${esc(r.Gru_cUserModifica)},\n        ${esc(formatDate(r.Gru_dFechaModifica))},\n        ${esc(r.Gru_cEquipoUser)}\n    )`);\n});\n\nif (values.length === 0) {\n    msg.payload = { status: \"ok\", insertados: 0 };\n    return msg;\n}\n\nmsg.topic = `\nINSERT INTO grupo (\n    Aca_cCategoria,\n    Gru_cGrupo,\n    Gru_cDescripLarga,\n    Gru_cDescripCorta,\n    Gru_cEstado,\n    Gru_cDeleted,\n    Gru_cUserCrea,\n    Gru_dFechaCrea,\n    Gru_cUserModifica,\n    Gru_dFechaModifica,\n    Gru_cEquipoUser\n)\nVALUES ${values.join(',')}\nON DUPLICATE KEY UPDATE\n    Gru_cDescripLarga = VALUES(Gru_cDescripLarga),\n    Gru_cDescripCorta = VALUES(Gru_cDescripCorta),\n    Gru_cEstado = VALUES(Gru_cEstado),\n    Gru_cDeleted = VALUES(Gru_cDeleted),\n    Gru_cUserModifica = VALUES(Gru_cUserModifica),\n    Gru_dFechaModifica = VALUES(Gru_dFechaModifica),\n    Gru_cEquipoUser = VALUES(Gru_cEquipoUser)\n`;\n\nmsg.payload = null;\nmsg.total = values.length;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":830,"y":80,"wires":[["ee2715a73e8c1268"]]},{"id":"ee2715a73e8c1268","type":"subflow:143d5ed27166ba3c","z":"d850890bbe7ced0f","name":"","x":1130,"y":80,"wires":[["resp_grp"]]},{"id":"resp_grp","type":"function","z":"d850890bbe7ced0f","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración grupo completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1380,"y":80,"wires":[[]]},{"id":"fn_cls_query","type":"function","z":"e3761457f220ce0c","name":"consulta migracion clase","func":"let emp = msg.req.body.Emp_cCodigo || '087';\n\nmsg.topic = `SELECT * FROM LGT_CLASE_BS WHERE Emp_cCodigo=@Emp_cCodigo`;\nmsg.params = [{ name:'Emp_cCodigo', type:'VarChar(3)', value:emp }];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":250,"y":80,"wires":[["7009d4f2ffdcdd9b"]]},{"id":"7009d4f2ffdcdd9b","type":"subflow:7a24865852a0fd5b","z":"e3761457f220ce0c","name":"","x":530,"y":80,"wires":[["fn_cls_transform"]]},{"id":"fn_cls_transform","type":"function","z":"e3761457f220ce0c","name":"Transform Clase + Bulk","func":"let rows = msg.payload;\nlet values = [];\n\n// función escape segura\nfunction esc(v) {\n    if (v === null || v === undefined) return \"NULL\";\n    return \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\n}\n\n// función fecha segura\nfunction fecha(v) {\n    if (!v) return \"NULL\";\n\n    let d = new Date(v);\n    if (isNaN(d.getTime())) return \"NULL\";\n\n    return `'${d.toISOString().slice(0, 19).replace('T', ' ')}'`;\n}\n\nrows.forEach(r => {\n\n    values.push(`(\n        ${esc(r.Aca_cCategoria)},\n        ${esc(r.Gru_cGrupo)},\n        ${esc(r.Cla_cClase)},\n        ${esc(r.Cla_cDescripLarga)},\n        ${esc(r.Cla_cDescripCorta)},\n        ${esc(r.Cla_cEstado)},\n        ${esc(r.Cla_cDeleted)},\n        ${esc(r.Cla_cUserCrea)},\n        ${fecha(r.Cla_dFechaCrea)},\n        ${esc(r.Cla_cUserModifica)},\n        ${fecha(r.Cla_dFechaModifica)},\n        ${esc(r.Cla_cEquipoUser)}\n    )`);\n\n});\n\nmsg.topic = `\nINSERT INTO clase (\n    Aca_cCategoria,\n    Gru_cGrupo,\n    Cla_cClase,\n    Cla_cDescripLarga,\n    Cla_cDescripCorta,\n    Cla_cEstado,\n    Cla_cDeleted,\n    Cla_cUserCrea,\n    Cla_dFechaCrea,\n    Cla_cUserModifica,\n    Cla_dFechaModifica,\n    Cla_cEquipoUser\n)\nVALUES ${values.join(',')}\n\nON DUPLICATE KEY UPDATE\n    Cla_cDescripLarga = VALUES(Cla_cDescripLarga),\n    Cla_cDescripCorta = VALUES(Cla_cDescripCorta),\n    Cla_cEstado = VALUES(Cla_cEstado),\n    Cla_cDeleted = VALUES(Cla_cDeleted),\n    Cla_cUserModifica = VALUES(Cla_cUserModifica),\n    Cla_dFechaModifica = VALUES(Cla_dFechaModifica),\n    Cla_cEquipoUser = VALUES(Cla_cEquipoUser)\n`;\n\nmsg.payload = null;\nmsg.total = values.length;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":840,"y":80,"wires":[["6fc6824a49feb865"]]},{"id":"6fc6824a49feb865","type":"subflow:143d5ed27166ba3c","z":"e3761457f220ce0c","name":"","x":1130,"y":80,"wires":[["resp_cls"]]},{"id":"resp_cls","type":"function","z":"e3761457f220ce0c","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración clase completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1370,"y":80,"wires":[[]]},{"id":"resp_fam","type":"function","z":"7d59a05f0ec995c8","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración familia completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1370,"y":80,"wires":[[]]},{"id":"f761f9837af74d5d","type":"subflow:143d5ed27166ba3c","z":"7d59a05f0ec995c8","name":"","x":1130,"y":80,"wires":[["resp_fam"]]},{"id":"fn_fam_transform","type":"function","z":"7d59a05f0ec995c8","name":"Transform Familia + Bulk","func":"let rows = msg.payload;\nlet values = [];\n\n// escape seguro\nfunction esc(v) {\n    if (v === null || v === undefined) return \"NULL\";\n    return \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\n}\n\n// fecha segura\nfunction fecha(v) {\n    if (!v) return \"NULL\";\n\n    let d = new Date(v);\n    if (isNaN(d.getTime())) return \"NULL\";\n\n    return `'${d.toISOString().slice(0, 19).replace('T', ' ')}'`;\n}\n\nrows.forEach(r => {\n\n    values.push(`(\n        ${esc(r.Aca_cCategoria)},\n        ${esc(r.Gru_cGrupo)},\n        ${esc(r.Cla_cClase)},\n        ${esc(r.Fam_cFamilia)},\n        ${esc(r.Fam_cDescripLarga)},\n        ${esc(r.Fam_cDescripCorta)},\n        ${esc(r.Fam_cEstado)},\n        ${esc(r.Fam_cDeleted)},\n        ${esc(r.Fam_cUserCrea)},\n        ${fecha(r.Fam_dFechaCrea)},\n        ${esc(r.Fam_cUserModifica)},\n        ${fecha(r.Fam_dFechaModifica)},\n        ${esc(r.Fam_cEquipoUser)}\n    )`);\n\n});\n\nmsg.topic = `\nINSERT INTO familia (\n    Aca_cCategoria,\n    Gru_cGrupo,\n    Cla_cClase,\n    Fam_cFamilia,\n    Fam_cDescripLarga,\n    Fam_cDescripCorta,\n    Fam_cEstado,\n    Fam_cDeleted,\n    Fam_cUserCrea,\n    Fam_dFechaCrea,\n    Fam_cUserModifica,\n    Fam_dFechaModifica,\n    Fam_cEquipoUser\n)\nVALUES ${values.join(',')}\n\nON DUPLICATE KEY UPDATE\n    Fam_cDescripLarga = VALUES(Fam_cDescripLarga),\n    Fam_cDescripCorta = VALUES(Fam_cDescripCorta),\n    Fam_cEstado = VALUES(Fam_cEstado),\n    Fam_cDeleted = VALUES(Fam_cDeleted),\n    Fam_cUserModifica = VALUES(Fam_cUserModifica),\n    Fam_dFechaModifica = VALUES(Fam_dFechaModifica),\n    Fam_cEquipoUser = VALUES(Fam_cEquipoUser)\n`;\n\nmsg.payload = null;\nmsg.total = values.length;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":850,"y":80,"wires":[["f761f9837af74d5d"]]},{"id":"f5773145d5a1b642","type":"subflow:7a24865852a0fd5b","z":"7d59a05f0ec995c8","name":"","x":530,"y":80,"wires":[["fn_fam_transform"]]},{"id":"fn_fam_query","type":"function","z":"7d59a05f0ec995c8","name":"consulta migracion familia","func":"let emp = msg.req.body.Emp_cCodigo || '087';\n\nmsg.topic = `SELECT * FROM LGT_FAMILIA WHERE Emp_cCodigo=@Emp_cCodigo`;\nmsg.params = [{ name:'Emp_cCodigo', type:'VarChar(3)', value:emp }];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":250,"y":80,"wires":[["f5773145d5a1b642"]]},{"id":"http_in_sql","type":"http in","z":"flow1","g":"710496859be7c313","name":"GET Consultar Entidades","url":"/maestros/consultarentidades","method":"get","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":170,"y":280,"wires":[["8446697e9d608d83"]]},{"id":"function_sql","type":"function","z":"flow1","g":"710496859be7c313","name":"consultar","func":"// parametros\nlet emp = msg.req.query.Emp_cCodigo || null;\nlet ent = msg.req.query.Ent_cCodEntidad || null;\n\n// query\nmsg.topic = `\nSELECT * \nFROM CNM_ENTIDAD \nWHERE Emp_cCodigo = @Emp_cCodigo \nAND Ten_cTipoEntidad = 'C' \nAND Ent_cCodEntidad = \n    (CASE \n        WHEN ISNULL(@Ent_cCodEntidad, '') = '' THEN Ent_cCodEntidad \n        ELSE @Ent_cCodEntidad \n     END)\n`;\n\n// 👇 FORMATO CORRECTO PARA MSSQL NODE\nmsg.params = [\n    {\n        name: \"Emp_cCodigo\",\n        type: \"VarChar\",\n        value: emp\n    },\n    {\n        name: \"Ent_cCodEntidad\",\n        type: \"VarChar\",\n        value: ent\n    }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":280,"wires":[["1c181471b1e4a7bc"]]},{"id":"3f823a24745d743c","type":"http in","z":"flow1","g":"710496859be7c313","name":"POST Migrar Clientes","url":"/maestros/migrarclientes","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":160,"y":180,"wires":[["9652d4c7603ca3ad"]]},{"id":"40e3c05e8a21b7e6","type":"function","z":"flow1","g":"710496859be7c313","name":"migrar","func":"let emp = msg.payload.Emp_cCodigo;\n\nmsg.topic = `\nSELECT *\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ten_cTipoEntidad = 'C'\nAND ISNULL(Ent_cDeleted,'') <> '*'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: emp }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":200,"wires":[["9c094d5549863d5d"]]},{"id":"c17b6bc640b47ef8","type":"function","z":"flow1","g":"710496859be7c313","name":"Transform + Bulk Insert","func":"let rows = msg.payload;\n\nfunction mapTipoDoc(tipo) {\n    switch (tipo) {\n        case \"01\": return 1;\n        case \"05\": return 2;\n        case \"03\": return 3;\n        default: return null;\n    }\n}\n\nfunction mapEstado(e) {\n    return (e === \"A\") ? \"Activado\" : \"Desactivado\";\n}\n\nlet data = [];\n\nmsg.total=0;\n\nrows.forEach(r => {\n\n    if (!r.Ent_nRuc) return;\n\n    let tipo = mapTipoDoc(r.Ent_cTipoDoc);\n    if (!tipo) return;\n\n    data.push([\n        tipo,\n        r.Ent_nRuc,\n        r.Ent_cPersona,\n        r.En_nMail,\n        r.Ent_nTelefono,\n        r.Ent_cCodEntidad,\n        mapEstado(r.Ent_cEstado),\n        r.Ent_cDireccion,\n        null,\n        r.Ent_dFechaCrea,\n        r.Ent_Observacion\n    ]);\n\n    msg.total++;\n});\n\nif (data.length === 0) {\n    msg.payload = { status: \"ok\", insertados: 0 };\n    return msg;\n}\n\nmsg.topic = `\nINSERT INTO clientes\n(id_tipo_documento, numero_documento, nombres, email, telefono, codigo_erp, estado, direccion, codigo_ubigeo, fecha_creacion, observaciones)\nVALUES ?\nON DUPLICATE KEY UPDATE\n\n    id_tipo_documento = IF(id_tipo_documento <> VALUES(id_tipo_documento), VALUES(id_tipo_documento), id_tipo_documento),\n\n    numero_documento = IF(numero_documento <> VALUES(numero_documento), VALUES(numero_documento), numero_documento),\n\n    nombres = IF(nombres <> VALUES(nombres), VALUES(nombres), nombres),\n\n    email = IF(email <> VALUES(email), VALUES(email), email),\n\n    telefono = IF(telefono <> VALUES(telefono), VALUES(telefono), telefono),\n\n    estado = IF(estado <> VALUES(estado), VALUES(estado), estado),\n\n    direccion = IF(direccion <> VALUES(direccion), VALUES(direccion), direccion),\n\n    codigo_ubigeo = IF(codigo_ubigeo <> VALUES(codigo_ubigeo), VALUES(codigo_ubigeo), codigo_ubigeo),\n\n    fecha_creacion = IF(fecha_creacion <> VALUES(fecha_creacion), VALUES(fecha_creacion), fecha_creacion),\n\n    observaciones = IF(observaciones <> VALUES(observaciones), VALUES(observaciones), observaciones)\n`;\n\nmsg.payload = [data];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1810,"y":200,"wires":[["4dd7a327da8df70b"]]},{"id":"4d8296f73816aa57","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración clientes completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2230,"y":200,"wires":[["505709848537fa18"]]},{"id":"http_in_cursos","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"POST Migrar Cursos","url":"/maestros/migrarcursos","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":150,"y":960,"wires":[["11542547392efddc"]]},{"id":"fn_sql_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"migrar","func":"let emp = msg.payload.Emp_cCodigo;\n\nmsg.topic = `\nSELECT *\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: emp }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":980,"wires":[["241392c2a1f7ee41"]]},{"id":"fn_transform_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Transform + Bulk Cursos","func":"let rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin datos\", insertados: 0 };\n    return msg;\n}\n\n// escape seguro\nfunction escape(val) {\n    if (val === null || val === undefined || val === \"\") return \"NULL\";\n    return \"'\" + String(val).replace(/'/g, \"''\") + \"'\";\n}\n\n// formatear fecha MSSQL → MySQL\nfunction formatDate(val) {\n    if (!val) return \"NULL\";\n\n    let d = new Date(val);\n    if (isNaN(d.getTime())) return \"NULL\";\n\n    let yyyy = d.getFullYear();\n    let mm = String(d.getMonth() + 1).padStart(2, '0');\n    let dd = String(d.getDate()).padStart(2, '0');\n\n    return `'${yyyy}-${mm}-${dd}'`;\n}\n\nlet values = [];\nlet total = 0;\n\nrows.forEach(r => {\n\n    if (!r.Cab_cCatalogo) return;\n\n    values.push(`(\n        1,\n        ${escape(r.Cab_cDescripLarga)},\n        '',\n        ${escape(r.Cab_cCatalogo)},\n        ${escape(r.Aca_cCategoria)},\n        ${escape(r.Gru_cGrupo)},\n        ${escape(r.Cla_cClase)},\n        ${escape(r.Fam_cFamilia)},\n        ${formatDate(r.Cab_dFechaCrea)},\n        ${escape(r.Cab_cUserCrea)},\n        ${formatDate(r.Cab_dFechaModifica)},\n        ${escape(r.Cab_cUserModifica)}\n    )`);\n\n    total++;\n});\n\nif (values.length === 0) {\n    msg.payload = { status: \"ok\", message: \"Sin registros válidos\", insertados: 0 };\n    return msg;\n}\n\nmsg.topic = `\nINSERT INTO cursos\n(\n    id_tipo_curso,\n    nombre,\n    descripcion,\n    codigo_erp,\n    categoria_erp,\n    grupo_erp,\n    clase_erp,\n    familia_erp,\n    fecha_creacion,\n    usuario_creacion,\n    fecha_modificacion,\n    usuario_modificacion\n)\nVALUES ${values.join(\",\")}\nON DUPLICATE KEY UPDATE\n    nombre = VALUES(nombre),\n    descripcion = VALUES(descripcion),\n    categoria_erp = VALUES(categoria_erp),\n    grupo_erp = VALUES(grupo_erp),\n    clase_erp = VALUES(clase_erp),\n    familia_erp = VALUES(familia_erp),\n    fecha_modificacion = VALUES(fecha_modificacion),\n    usuario_modificacion = VALUES(usuario_modificacion)\n`;\n\nmsg.payload = null;\nmsg.total = total;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1810,"y":980,"wires":[["5fb3689e443b5fc6"]]},{"id":"fn_response_cursos","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Migración cursos completada\",\n    registros_procesados: msg.total || 0\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2250,"y":980,"wires":[["dacb96d7f45f5fc0"]]},{"id":"759e380d42f42721","type":"http in","z":"flow1","g":"710496859be7c313","name":"POST Crear Cliente","url":"/maestros/crearcliente","method":"post","x":150,"y":380,"wires":[["fefdab3ec1bac1be"]]},{"id":"8e1f3e8aee0a8840","type":"function","z":"flow1","g":"710496859be7c313","name":"insertar","func":"let b = msg.body;\n\n// simple random (puedes cambiar a correlativo real)\nlet codigo = Math.floor(10000 + Math.random() * 90000).toString();\n\nmsg.topic = `\nINSERT INTO CNM_ENTIDAD (\n    Emp_cCodigo,\n    Ent_cCodEntidad,\n    Ten_cTipoEntidad,\n    Ent_cPersona,\n    Ent_cDireccion,\n    Ent_nRuc,\n    Ent_cTipoDoc,\n    En_nMail,\n    Ent_nTelefono,\n    Ent_cEstado,\n    Ent_dFechaCrea\n)\nVALUES (\n    @Emp_cCodigo,\n    @Ent_cCodEntidad,\n    'C',\n    @Ent_cPersona,\n    @Ent_cDireccion,\n    @Ent_nRuc,\n    @Ent_cTipoDoc,\n    @En_nMail,\n    @Ent_nTelefono,\n    @Ent_cEstado,\n    GETDATE()\n)\n`;\n\n// 🔥 MAPEO ESTADO\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: codigo },\n  { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n  { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n  { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n  { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n  { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n  { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n  { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado }\n];\n\nmsg.codigo = codigo;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":380,"wires":[["1c8a682048791a6a"]]},{"id":"19b3c06ba96cd553","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = {\n    statuscode: 200,\n    status: \"ok\",\n    message: \"Cliente creado en SQL Server\",\n    codigo_generado: msg.codigo\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":380,"wires":[["http_response_delete"]]},{"id":"http_in_update","type":"http in","z":"flow1","g":"710496859be7c313","name":"PUT Editar Cliente","url":"/maestros/editarcliente","method":"put","x":150,"y":480,"wires":[["cd6b6f6b2e734941"]]},{"id":"fn_update","type":"function","z":"flow1","g":"710496859be7c313","name":"actualizar","func":"let b = msg.payload;\n\nlet estado = (b.estado === \"Activado\") ? \"A\" : \"X\";\n\nmsg.topic = `\nUPDATE CNM_ENTIDAD\nSET\n    Ent_cPersona = @Ent_cPersona,\n    Ent_cDireccion = @Ent_cDireccion,\n    Ent_nRuc = @Ent_nRuc,\n    Ent_cTipoDoc = @Ent_cTipoDoc,\n    En_nMail = @En_nMail,\n    Ent_nTelefono = @Ent_nTelefono,\n    Ent_cEstado = @Ent_cEstado,\n    Ent_dFechaModifica = GETDATE()\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo },\n  { name: \"Ent_cPersona\", type: \"VarChar(500)\", value: b.nombres },\n  { name: \"Ent_cDireccion\", type: \"VarChar(500)\", value: b.direccion || \"\" },\n  { name: \"Ent_nRuc\", type: \"VarChar(20)\", value: b.numero_documento },\n  { name: \"Ent_cTipoDoc\", type: \"VarChar(2)\", value: b.id_tipo_documento },\n  { name: \"En_nMail\", type: \"VarChar(100)\", value: b.email || \"\" },\n  { name: \"Ent_nTelefono\", type: \"VarChar(50)\", value: b.telefono || \"\" },\n  { name: \"Ent_cEstado\", type: \"VarChar(1)\", value: estado }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":480,"wires":[["fd49c9bf7b46c607"]]},{"id":"fn_resp_update","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = { \n    statuscode: 200,\n    status: \"ok\", \n    message: \"Cliente actualizado\" \n    };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":480,"wires":[["http_response_delete"]]},{"id":"http_in_delete","type":"http in","z":"flow1","g":"710496859be7c313","name":"DELETE Cliente","url":"/maestros/eliminarcliente","method":"delete","x":140,"y":580,"wires":[["79e43b1907658d52"]]},{"id":"fn_delete","type":"function","z":"flow1","g":"710496859be7c313","name":"eliminar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE CNM_ENTIDAD\nSET\n    Ent_cDeleted = '*',\n    Ent_dFechaModifica = GETDATE()\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ent_cCodEntidad = @Ent_cCodEntidad\nAND Ten_cTipoEntidad = 'C'\n`;\n\nmsg.params = [\n  { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n  { name: \"Ent_cCodEntidad\", type: \"VarChar(5)\", value: b.codigo }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":580,"wires":[["bfba9955becb5a71"]]},{"id":"fn_resp_delete","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"msg.payload = { statuscode: 200, status: \"ok\", message: \"Cliente eliminado (soft delete)\" };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":580,"wires":[["http_response_delete"]]},{"id":"http_response_delete","type":"http response","z":"flow1","g":"710496859be7c313","name":"HTTP Response","x":2780,"y":460,"wires":[]},{"id":"http_in_ultimo","type":"http in","z":"flow1","g":"710496859be7c313","name":"GET Ultimo Codigo","url":"/maestros/ultimocodigo","method":"get","x":150,"y":680,"wires":[["c26d42f6be1e8087"]]},{"id":"fn_query_ultimo","type":"function","z":"flow1","g":"710496859be7c313","name":"codigo","func":"// puedes hacerlo dinámico si quieres\nlet emp = msg.req.query.Emp_cCodigo || '087';\n\nmsg.topic = `\nSELECT ISNULL(MAX(Ent_cCodEntidad), '00000') AS ultimo\nFROM CNM_ENTIDAD\nWHERE Emp_cCodigo = @Emp_cCodigo\nAND Ten_cTipoEntidad = 'C'\nAND LEFT(Ent_cCodEntidad,1) <> 'A'\n`;\n\nmsg.params = [\n  {\n    name: \"Emp_cCodigo\",\n    type: \"VarChar(3)\",\n    value: emp\n  }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":680,"wires":[["dd51b8460f247e67"]]},{"id":"fn_build_response","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"let data = msg.payload;\n\nlet ultimo = data && data[0] ? data[0].ultimo : '00000';\n\n// convertir a número y sumar\nlet siguiente = (parseInt(ultimo) + 1).toString().padStart(5, '0');\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  ultimo: ultimo,\n  siguiente: siguiente\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":680,"wires":[["http_response_delete"]]},{"id":"bf0c7ab07c2ad5f7","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"POST Crear Curso","url":"/maestros/crearcursos","method":"post","x":150,"y":1160,"wires":[["dd2292abce87806d"]]},{"id":"11c18464a2c13b36","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"insertar","func":"let b = msg.payload;\n\nmsg.topic = `\nINSERT INTO LGM_CATALOGO_BS (\n Emp_cCodigo,\n Cab_cCatalogo,\n Cab_cDescripLarga,\n Cab_cEstado,\n Cab_dFechaCrea\n)\nVALUES (\n @Emp_cCodigo,\n @Cab_cCatalogo,\n @Cab_cDescripLarga,\n 'A',\n GETDATE()\n)\n`;\n\nmsg.params = [\n { name: \"Emp_cCodigo\", type: \"VarChar(3)\", value: b.Emp_cCodigo },\n { name: \"Cab_cCatalogo\", type: \"VarChar(6)\", value: b.codigo },\n { name: \"Cab_cDescripLarga\", type: \"VarChar(600)\", value: b.nombre }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1180,"wires":[["3311302718add704"]]},{"id":"3b38cdd578c0ce8f","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode: 200,\n status:\"ok\",\n message:\"Curso creado correctamente\"\n };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":1180,"wires":[["9951258e36bd20e5"]]},{"id":"8cedfe2f2b926f49","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"PUT Editar Curso","url":"/maestros/editarcursos","method":"put","x":140,"y":1260,"wires":[["6c8309febf1deb96"]]},{"id":"68195ff263539964","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"actualizar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE LGM_CATALOGO_BS\nSET Cab_cDescripLarga=@nombre,\n Cab_dFechaModifica=GETDATE()\nWHERE Emp_cCodigo=@Emp_cCodigo\nAND Cab_cCatalogo=@codigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:b.Emp_cCodigo },\n { name:\"codigo\", type:\"VarChar(6)\", value:b.codigo },\n { name:\"nombre\", type:\"VarChar(600)\", value:b.nombre }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1280,"wires":[["25f7d3e6971a72d6"]]},{"id":"3718e0d4dfd3a107","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode:200,   \n status:\"ok\",\n message:\"Curso actualizado correctamente\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":1280,"wires":[["9951258e36bd20e5"]]},{"id":"e455fd0114cc6f94","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"DELETE Curso","url":"/maestros/eliminarcursos","method":"delete","x":140,"y":1360,"wires":[["18bb4a4012c010d5"]]},{"id":"7e993e34788baf41","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"eliminar","func":"let b = msg.payload;\n\nmsg.topic = `\nUPDATE LGM_CATALOGO_BS\nSET Cab_cDeleted='*', Cab_dFechaModifica=GETDATE()\nWHERE Emp_cCodigo=@Emp_cCodigo\nAND Cab_cCatalogo=@codigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:b.Emp_cCodigo },\n { name:\"codigo\", type:\"VarChar(6)\", value:b.codigo }\n];\n\nmsg._input = b;\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":1380,"wires":[["4572e0d5424b12c6"]]},{"id":"b1715579048129d7","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"msg.payload = {\n statuscode: 200,    \n status:\"ok\",\n message:\"Curso eliminado correctamente\"\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":1380,"wires":[["9951258e36bd20e5"]]},{"id":"e5b3803b6d5f5c72","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"GET Ultimo Codigo","url":"/maestros/ultimocodigocurso","method":"get","x":150,"y":1460,"wires":[["53e6e86435d2d186"]]},{"id":"12fd2d89b136fbe2","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"codigo","func":"let emp = msg.req.query.Emp_cCodigo || '01';\n\nmsg.topic = `\nSELECT ISNULL(MAX(Cab_cCatalogo),'000000') AS ultimo\nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo=@Emp_cCodigo\n`;\n\nmsg.params = [\n { name:\"Emp_cCodigo\", type:\"VarChar(3)\", value:emp }\n];\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1130,"y":1480,"wires":[["a2356516365a204a"]]},{"id":"4e18691aa3a85c7a","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"let ultimo = msg.payload[0]?.ultimo || '000000';\nlet siguiente = (parseInt(ultimo)+1).toString().padStart(6,'0');\n\nmsg.payload = {\n statuscode: 200,\n status:\"ok\",\n ultimo: ultimo,\n siguiente: siguiente  \n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1770,"y":1480,"wires":[["9951258e36bd20e5"]]},{"id":"9951258e36bd20e5","type":"http response","z":"flow1","g":"4d6e82be6b5f92e4","name":"HTTP Response","statusCode":"","headers":{},"x":2780,"y":1300,"wires":[]},{"id":"18f4a24c6071fed8","type":"catch","z":"flow1","g":"710496859be7c313","name":"ERROR","scope":"group","uncaught":false,"x":2300,"y":680,"wires":[["d3e5365830b78553"]]},{"id":"d3e5365830b78553","type":"function","z":"flow1","g":"710496859be7c313","name":"RESPONSE","func":"msg.statusCode=500;msg.payload={status:'error',message:msg.error.message,timestamp:new Date().toISOString()};return msg;","outputs":1,"timeo