:0,"initialize":"","finalize":"","libs":[],"x":400,"y":380,"wires":[["4b56bd36549740bd"]]},{"id":"cd6b6f6b2e734941","type":"function","z":"flow1","g":"710496859be7c313","name":"actualizar","func":"msg.caso =\"actualizar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":480,"wires":[["4b56bd36549740bd"]]},{"id":"79e43b1907658d52","type":"function","z":"flow1","g":"710496859be7c313","name":"eliminar","func":"msg.caso =\"eliminar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":580,"wires":[["4b56bd36549740bd"]]},{"id":"c26d42f6be1e8087","type":"function","z":"flow1","g":"710496859be7c313","name":"codigo","func":"msg.caso =\"codigo\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":680,"wires":[["4b56bd36549740bd"]]},{"id":"11542547392efddc","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"migrar","func":"msg.caso =\"migrar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":840,"wires":[["fc1514f439141385"]]},{"id":"dd2292abce87806d","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"insertar","func":"msg.caso =\"insertar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1040,"wires":[["fc1514f439141385"]]},{"id":"6c8309febf1deb96","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"actualizar","func":"msg.caso =\"actualizar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1140,"wires":[["fc1514f439141385"]]},{"id":"18bb4a4012c010d5","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"eliminar","func":"msg.caso =\"eliminar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":1240,"wires":[["fc1514f439141385"]]},{"id":"53e6e86435d2d186","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"codigo","func":"msg.caso =\"codigo\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":1340,"wires":[["fc1514f439141385"]]},{"id":"fc1514f439141385","type":"subflow:4288a9a7238e6cf3","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":680,"y":1100,"wires":[["6801ea96c00586c8"],["3e43db00f7b659f9"]]},{"id":"6801ea96c00586c8","type":"switch","z":"flow1","g":"4d6e82be6b5f92e4","name":"ROUTER","property":"caso","propertyType":"msg","rules":[{"t":"eq","v":"migrar","vt":"str"},{"t":"eq","v":"consultar","vt":"str"},{"t":"eq","v":"insertar","vt":"str"},{"t":"eq","v":"actualizar","vt":"str"},{"t":"eq","v":"eliminar","vt":"str"},{"t":"eq","v":"codigo","vt":"str"}],"repair":false,"outputs":6,"x":900,"y":1100,"wires":[["fn_sql_cursos"],["3721dea03f213698"],["11c18464a2c13b36"],["68195ff263539964"],["7e993e34788baf41"],["12fd2d89b136fbe2"]]},{"id":"15062529a5a031af","type":"http in","z":"flow1","g":"4d6e82be6b5f92e4","name":"GET Consultar Cursos","url":"/maestros/consultarcursos","method":"get","upload":false,"skipBodyParsing":false,"swaggerDoc":"","x":160,"y":940,"wires":[["b9aa73ebde4d9dbc"]]},{"id":"b9aa73ebde4d9dbc","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"consultar","func":"msg.caso =\"consultar\"\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":940,"wires":[["fc1514f439141385"]]},{"id":"3721dea03f213698","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"consultar","func":"// parametros\nlet emp = msg.req.query.Emp_cCodigo || null;\nlet cat = msg.req.query.Cab_cCatalogo || null;\n\n// query\nmsg.topic = `\nSELECT * \nFROM LGM_CATALOGO_BS\nWHERE Emp_cCodigo = @Emp_cCodigo \nAND Cab_cCatalogo = \n    (CASE \n        WHEN ISNULL(@Cab_cCatalogo, '') = '' THEN Cab_cCatalogo\n        ELSE @Cab_cCatalogo\n     END)\n`;\n\n// 👇 FORMATO CORRECTO PARA MSSQL NODE\nmsg.params = [\n    {\n        name: \"Emp_cCodigo\",\n        type: \"VarChar\",\n        value: emp\n    },\n    {\n        name: \"Cab_cCatalogo\",\n        type: \"VarChar\",\n        value: cat\n    }\n];\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1140,"y":960,"wires":[["aafd3a41326ff5f4"]]},{"id":"9c094d5549863d5d","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":200,"wires":[["c17b6bc640b47ef8"]]},{"id":"1c181471b1e4a7bc","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":280,"wires":[["464697d85bee965c"]]},{"id":"1c8a682048791a6a","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":380,"wires":[["19b3c06ba96cd553"]]},{"id":"fd49c9bf7b46c607","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":480,"wires":[["fn_resp_update"]]},{"id":"bfba9955becb5a71","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":580,"wires":[["fn_resp_delete"]]},{"id":"dd51b8460f247e67","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"710496859be7c313","name":"","x":1330,"y":680,"wires":[["fn_build_response"]]},{"id":"464697d85bee965c","type":"function","z":"flow1","g":"710496859be7c313","name":"Respuesta","func":"let data = msg.payload;\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  data: data\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":280,"wires":[["http_response_delete"]]},{"id":"b43d5f8a0f5aec1d","type":"function","z":"flow1","g":"4d6e82be6b5f92e4","name":"Respuesta","func":"let data = msg.payload;\n\nmsg.payload = {\n  statuscode: 200,\n  status: \"ok\",\n  data: data\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1550,"y":960,"wires":[["9951258e36bd20e5"]]},{"id":"241392c2a1f7ee41","type":"subflow:7a24865852a0fd5b","z":"flow1","g":"4d6e82be6b5f92e4","name":"","x":1330,"y